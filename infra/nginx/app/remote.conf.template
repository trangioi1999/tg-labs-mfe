# Static server for a Remote image (rendered by the nginx entrypoint's
# envsubst step into /etc/nginx/conf.d/default.conf).
#
# ${REMOTE_CORS_ORIGIN} lets a Shell on another origin load this remote's
# remoteEntry.json and chunks. Behind the gateway everything is same-origin.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~* \.json$ {
        add_header Access-Control-Allow-Origin "${REMOTE_CORS_ORIGIN}" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location ~* \.(?:js|css)$ {
        add_header Access-Control-Allow-Origin "${REMOTE_CORS_ORIGIN}" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Standalone mode (opening the remote directly) is a SPA as well.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
