{
  "name": "tools-mfe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "tg",
  "sourceRoot": "apps/tools-mfe/src",
  "tags": ["type:app", "scope:tools"],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/tools-mfe"],
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "apps/tools-mfe/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "tools-mfe:esbuild:production"
        },
        "development": {
          "target": "tools-mfe:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "tools-mfe:serve-original:development",
        "tsConfig": "apps/tools-mfe/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      },
      "continuous": true
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "buildTarget": "tools-mfe:esbuild:development"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "tools-mfe:build",
        "port": 4203,
        "staticFilePath": "dist/apps/tools-mfe/browser",
        "spa": true
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/tools-mfe",
        "browser": "apps/tools-mfe/src/main.ts",
        "tsConfig": "apps/tools-mfe/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/tools-mfe/public"
          }
        ],
        "styles": ["apps/tools-mfe/src/styles.css"],
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "48kb",
              "maximumError": "96kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "outputPath": "dist/dev/apps/tools-mfe"
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4203
      },
      "configurations": {
        "production": {
          "buildTarget": "tools-mfe:esbuild:production"
        },
        "development": {
          "buildTarget": "tools-mfe:esbuild:development"
        }
      }
    }
  }
}
