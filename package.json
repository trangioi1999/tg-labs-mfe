{
  "name": "tg-labs",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "nx run-many -t serve -p shell blog-mfe docs-mfe tools-mfe playground-mfe",
    "start:shell": "nx serve shell",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "affected": "nx affected -t lint test build",
    "docker:up": "docker compose --env-file .env -f compose/docker-compose.yml up --build -d",
    "docker:down": "docker compose --env-file .env -f compose/docker-compose.yml down",
    "build:pages": "nx run-many -t build -p shell blog-mfe docs-mfe tools-mfe playground-mfe && node tools/scripts/assemble-pages.mjs"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "~22.2.2",
    "@angular-devkit/core": "~22.2.2",
    "@angular-devkit/schematics": "~22.2.2",
    "@angular/build": "~22.2.2",
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "~22.2.2",
    "@angular/language-service": "~22.2.2",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "^23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@schematics/angular": "~22.2.2",
    "@softarc/native-federation-orchestrator": "^4.6.0",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "~4.3.3",
    "@types/node": "^22.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.0.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "nx": "23.3.0",
    "postcss": "^8.5.29",
    "prettier": "~3.6.2",
    "tailwindcss": "~4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
