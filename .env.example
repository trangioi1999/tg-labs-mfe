# Copy to .env and adjust. Never commit .env.
# Used by: docker compose --env-file .env -f compose/docker-compose.yml ...

# Host port of the Nginx gateway (single public entry point).
GATEWAY_PORT=8080

# Image naming. Locally built images are tagged tg-labs/<app>:local.
IMAGE_REGISTRY=tg-labs
IMAGE_TAG=local

# Sections to show: comma-separated blog,docs,tools,playground — or "all".
# Disabled sections disappear from the navigation and home page, and their
# URLs show the 404 page. Takes effect on container restart (no rebuild).
ENABLED_REMOTES=all

# Remote entry URLs written into the Shell's federation.manifest.json at
# container start. Defaults route through the gateway on the same origin.
# Use absolute URLs (https://...) to point at remotes deployed elsewhere.
REMOTE_BLOG_URL=/mfe/blog/remoteEntry.json
REMOTE_DOCS_URL=/mfe/docs/remoteEntry.json
REMOTE_TOOLS_URL=/mfe/tools/remoteEntry.json
REMOTE_PLAYGROUND_URL=/mfe/playground/remoteEntry.json

# Origin allowed to fetch remote federation files cross-origin.
# Restrict to the Shell's public origin (e.g. https://tglabs.dev) when remotes
# are served from a different domain.
REMOTE_CORS_ORIGIN=*
